#!/bin/bash
set -uo pipefail

# Prevent direct commits to main
branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ]; then
  echo "ERROR: Direct commits to the main branch are forbidden."
  exit 1
fi

# Format only staged HCL/TF files, then re-stage them so the
# formatted result is what actually gets committed.
echo "Formatting staged HCL and Terraform files..."

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.hcl' '*.tf' \
  | grep -v '\.terragrunt-cache/' || true)

formatted_dirs=" "
while IFS= read -r file; do
  [ -n "$file" ] || continue
  [ -f "$file" ] || continue
  if [[ "$file" == *.hcl ]]; then
    dir="$(dirname "$file")"
    # Avoid formatting the same directory twice.
    case "$formatted_dirs" in
      *" $dir "*) : ;;
      *)
        terragrunt hcl format --working-dir "$dir" >/dev/null 2>&1 \
          || terragrunt hclfmt --working-dir "$dir" >/dev/null 2>&1 || true
        formatted_dirs="$formatted_dirs$dir "
        ;;
    esac
  else
    tofu fmt "$file" >/dev/null 2>&1 || true
  fi
  git add -- "$file"
done <<EOF
$staged
EOF
