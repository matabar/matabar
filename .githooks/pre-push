#!/bin/bash
set -uo pipefail

# Validate only terragrunt stacks whose config changed in commits being pushed.
dirs=""
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base=$(git merge-base "$local_sha" main 2>/dev/null || true)
    if [ -n "$base" ]; then
      range="${base}..${local_sha}"
    else
      range="$local_sha"
    fi
  else
    range="${remote_sha}..${local_sha}"
  fi

  while IFS= read -r file; do
    [ -n "$file" ] || continue
    [ -f "$file" ] || continue
    dir=$(dirname "$file")
    case " $dirs " in
      *" $dir "*) ;;
      *) dirs="$dirs $dir" ;;
    esac
  done < <(git diff --name-only "$range" -- '**/terragrunt.hcl' 2>/dev/null || true)
done

dirs=$(echo "$dirs" | tr ' ' '\n' | sed '/^$/d' | sort -u)

if [ -z "$dirs" ]; then
  echo "No terragrunt.hcl changes in push; skipping validation."
  exit 0
fi

echo "Validating changed infrastructure stacks..."
repo_root="$(git rev-parse --show-toplevel)"
# A cache initialized with -backend=false cannot answer dependency outputs.
find "$repo_root" -type d -name .terragrunt-cache -prune -exec rm -rf {} +
failed=0
for dir in $dirs; do
  (
    cd "$repo_root/$dir" && unset GIT_DIR
    # Local-backend units can init for real. GCS units must not require the
    # bucket or credentials; mocks cover missing dependency outputs.
    if grep -q 'backend = "local"' terragrunt.hcl; then
      terragrunt init -reconfigure --non-interactive
    else
      terragrunt init -backend=false -reconfigure --non-interactive
    fi
    terragrunt validate --non-interactive
  ) || {
    echo "ERROR: Validation failed in $dir"
    failed=1
  }
done

if [ "$failed" -ne 0 ]; then
  echo "ERROR: Infrastructure validation failed. Push aborted."
  exit 1
fi
