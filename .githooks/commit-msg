#!/bin/sh
# Check the subject line against the Conventional Commits types and the
# allowed scopes listed in AGENTS.md. Dependency-free POSIX shell.
set -u

subject=$(sed -n '1p' "$1")

# Never block merge, revert, fixup, squash, or amend-style subjects.
case "$subject" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

types="feat fix docs style refactor perf test build ci chore revert"
# Fixed scopes, plus one scope per project directory (apps/<name>, packages/<name>).
scopes="infra site ci deps repo"
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
for dir in "$root"/apps/* "$root"/packages/*; do
  [ -d "$dir" ] && scopes="$scopes $(basename "$dir")"
done

fail() {
  echo "ERROR: $1" >&2
  echo "  subject: $subject" >&2
  echo "  expected: <type>[(scope)][!]: <description>" >&2
  echo "  types:  $types" >&2
  echo "  scopes: $scopes (see AGENTS.md)" >&2
  exit 1
}

type=$(printf '%s' "$subject" | sed -n 's/^\([a-z]*\)[(!:].*/\1/p')
[ -n "$type" ] || fail "subject is not a Conventional Commit."
case " $types " in *" $type "*) ;; *) fail "unknown type '$type'." ;; esac

rest=${subject#"$type"}
case "$rest" in
  "("*)
    scope=$(printf '%s' "$rest" | sed -n 's/^(\([^)]*\)).*/\1/p')
    case " $scopes " in *" $scope "*) ;; *) fail "unknown scope '$scope'." ;; esac
    rest=${rest#"($scope)"}
    ;;
esac
case "$rest" in
  ": "?* | "!: "?*) ;;
  *) fail "expected ': ' and a description after the type and scope." ;;
esac
