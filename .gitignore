# Terraform / OpenTofu
.terraform
.terraform.*
# Provider lock files are .terraform.lock.hcl and must be committed.
!.terraform.lock.hcl
# Units under infra/live/ copy the module lock on init; only the module copy is kept.
infra/live/**/.terraform.lock.hcl
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
*.tfvars
*.tfvars.json
override.tf
override.tf.json
_override.tf
_override.tf.json
.terraformrc
terraform.rc

# Terragrunt
.terragrunt-cache/
terragrunt-debug.tfvars
.github/ci-out/

# Local secrets (project root only — never commit)
.env
*.pem

# Logs
*.log
.tflint.d/

# OS files
.DS_Store
Thumbs.db
