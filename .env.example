# Copy to .env and fill in values. .env is git-ignored.
# Load before terragrunt:  set -a && source .env && set +a

# DuckDNS API token — https://www.duckdns.org/domains (shown at top after login)
TF_VAR_duckdns_token=

# Let's Encrypt registration email (optional; live config defaults to owner email)
TF_VAR_certbot_email=owner@example.com
